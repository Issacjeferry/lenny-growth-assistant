# Database configuration (PostgreSQL 16 with pgvector)
# When running with Docker Compose use host 'db', for local host use 'localhost'
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/lenny

# LLM Provider selection (ollama | anthropic | openai)
LLM_PROVIDER=ollama

# Ollama local configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional Cloud API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Observability and logging
LOG_LEVEL=INFO

# Vector similarity search threshold (cosine distance)
MAX_COSINE_DISTANCE=0.35
