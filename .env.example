# Database configuration (PostgreSQL 16 with pgvector)
# Docker Compose uses db:5432. For host Python use 127.0.0.1:55432.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/lenny

# LLM Provider selection (ollama | anthropic)
LLM_PROVIDER=ollama

# Ollama local configuration
# Direct Python execution talks to the Windows host.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker Desktop containers reach the host through this separate override.
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
# Create with: ollama create lenny-local -f models/Modelfile
OLLAMA_MODEL=lenny-local
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional Cloud API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
# OpenAI is reserved configuration, not an implemented provider.
OPENAI_MODEL=
MODEL_TIMEOUT_SECONDS=900

# Observability and logging
LOG_LEVEL=INFO

# Vector similarity search threshold (cosine distance)
MAX_COSINE_DISTANCE=0.35
